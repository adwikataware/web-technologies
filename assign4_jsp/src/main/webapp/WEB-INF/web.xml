<?xml version="1.0" encoding="UTF-8"?>
<!--
    There are no servlet classes in this assignment — index.jsp is the whole
    application, so this descriptor only names the welcome file and pins the
    request/response encoding.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>Electricity Bill Calculator (JSP)</display-name>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Read form input as UTF-8 so names and addresses survive the round trip. -->
  <request-character-encoding>UTF-8</request-character-encoding>
  <response-character-encoding>UTF-8</response-character-encoding>

</web-app>
